@model IEnumerable<GESTIONCOMMANDES.Models.Entities.Produit>
@using System.Globalization;
@{
  Layout = "_Layout";
  ViewData["Title"] = "Liste des Produits";
}

<div class="container mx-auto py-8">
  <div class="grid lg:grid-cols-3 gap-6">
    @foreach (var produit in Model)
    {
      <article class="bg-gray-100 rounded-lg shadow-lg p-4">
        <!-- Lien vers les détails du produit -->
        <a href="@Url.Action("Details", "Produit", new { id = produit.Id })" class="relative block">
          <img src="/produits/@produit.ImageFileName" alt="Image de @produit.Libelle" class="rounded-lg w-full">
          @if (produit.PourcentageSolde.HasValue)
          {
            <span class="absolute top-2 left-2 bg-red-500 text-white text-xs px-2 py-1 rounded">
              -@produit.PourcentageSolde.Value.ToString("0")%
            </span>
          }
        </a>
        <h2 class="text-sm font-medium text-gray-800 mt-4">@produit.Libelle</h2>
        <div class="mt-2">
          @if (produit.PourcentageSolde.HasValue)
          {
            <span class="text-red-600 font-bold text-lg">
              @produit.PrixSolde.ToString("C", CultureInfo.CreateSpecificCulture("fr-SN"))
            </span>
            <span class="text-gray-400 line-through text-sm ml-2">
              @produit.Prix.ToString("C", CultureInfo.CreateSpecificCulture("fr-SN"))
            </span>
          }
          else
          {
            <span class="text-gray-800 font-bold text-lg">
              @produit.Prix.ToString("C", CultureInfo.CreateSpecificCulture("fr-SN"))
            </span>
          }
        </div>
      </article>
    }
  </div>
</div>
