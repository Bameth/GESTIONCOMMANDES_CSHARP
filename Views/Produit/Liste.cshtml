@model PaginationViewModel
@{
    Layout = "_Layout";
}
@{
    ViewData["Title"] = "Gestion des Produits";
}

<div class="bg-gradient-to-br from-indigo-300 min-h-screen py-6">
    <div class="max-w-7xl mx-auto bg-white shadow-lg rounded-3xl p-8 space-y-8">
        <!-- Header -->
        <div class="flex justify-between items-center mb-6">
            <h1 class="text-5xl font-extrabold text-gray-800 tracking-tight hover:text-indigo-600 transition-all duration-300">Liste des Produits</h1>
            <a href="@Url.Action("Create", "Produit")" class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-green-500 to-green-700 text-white rounded-lg shadow-xl hover:shadow-2xl hover:scale-110 transition-all duration-300">
                Nouveau
                <svg class="h-6 w-6 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
            </a>
        </div>

        <!-- Success Message -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="mb-4 p-4 bg-green-100 text-green-700 border-l-4 border-green-500 rounded-lg shadow-lg">
                <i class="fas fa-check-circle mr-2"></i>
                @TempData["SuccessMessage"]
            </div>
        }

        <!-- Search Form -->
        <form method="get" action="@Url.Action("Liste", "Produit")" class="flex flex-col md:flex-row items-center space-x-4 mb-8 p-6 bg-gradient-to-br from-blue-50 to-indigo-50 shadow-md rounded-lg">
            <div class="relative flex-grow mb-4 md:mb-0">
                <input type="text" name="libelle" placeholder="Rechercher par Libellé..." class="border border-gray-300 rounded-lg pl-12 pr-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 w-full transition-all duration-300" />
            </div>

            <div class="relative mb-4 md:mb-0">
                <select name="etat" class="border border-gray-300 rounded-lg pl-4 pr-4 py-3 focus:outline-none focus:ring-2 focus:ring-indigo-500 w-full transition-all duration-300">
                    <option value="">État</option>
                    <option value="1">Disponible</option>
                    <option value="0">Non disponible</option>
                </select>
            </div>

            <button type="submit" class="px-6 py-3 bg-indigo-600 text-white rounded-lg shadow-lg hover:bg-indigo-700 transition-all duration-300 flex items-center">
                <i class="fas fa-search mr-2"></i> Rechercher
            </button>
        </form>

        <!-- Products Cards -->
       <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            @if (Model.Produits != null && Model.Produits.Any())
            {
                @foreach (var produit in Model.Produits)
                {
                    <div class="bg-white shadow-lg rounded-lg p-6 transform hover:scale-105 transition duration-300">
                        <div class="flex justify-center mb-4">
                            <img src="/produits/@produit.ImageFileName" alt="Image du produit" class="w-32 h-32 object-cover rounded-full shadow-md" />
                        </div>
                        <h3 class="text-xl font-bold text-gray-800 text-center">@produit.Libelle</h3>
                        <p class="text-center text-gray-600 mt-2">@produit.Prix.ToString("C")</p>
                        <p class="text-center text-sm text-gray-500">Quantité : @produit.QteStock</p>

                        <!-- Etat -->
                        <div class="flex justify-center mt-4">
                            <span class="inline-flex items-center px-3 py-1 text-sm font-medium text-white rounded-full
                                    @(produit.EtatProduit() ? "bg-green-500" : "bg-red-500")">
                                @(produit.EtatProduit() ? "Disponible" : "Non disponible")
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 ml-2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                                </svg>
                            </span>
                        </div>

                        <!-- Actions -->
                        <div class="flex justify-around mt-6 space-x-4">
                            <a href="@Url.Action("Edit", "Produit", new { id = produit.Id })" class="text-blue-600 hover:text-blue-800 transition-colors duration-300">
                                <i class="fas fa-eye"></i> Détails
                            </a>
                            <a href="@Url.Action("Delete", "Produit", new { id = produit.Id })" class="text-red-600 hover:text-red-800 transition-colors duration-300">
                                <i class="fas fa-trash"></i> Supprimer
                            </a>
                            <a href="@Url.Action("ApplyDiscount", "Produit", new { id = produit.Id })" class="text-green-600 hover:text-green-800 transition-colors duration-300">
                                <i class="fas fa-percent"></i> Remise
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-span-full text-center text-gray-500 py-6">
                    Aucun produit disponible.
                </div>
            }
        </div>

        <!-- Pagination -->
        <div class="pagination mt-8 flex justify-center space-x-2">
            @if (Model.CurrentPage > 1)
            {
                <a href="@Url.Action("Liste", "Produit", new { page = Model.CurrentPage - 1 })"
                   class="px-6 py-3 bg-indigo-600 text-white rounded-lg shadow-md hover:bg-indigo-700 transition-all duration-300 ease-in-out transform hover:scale-105"
                   aria-label="Page précédente">
                   Précédent
                </a>
            }

            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a href="@Url.Action("Liste", "Produit", new { page = i })"
                   class="px-4 py-3 border border-indigo-600 rounded-lg text-sm font-medium hover:bg-indigo-600 hover:text-white transition-all duration-300 @(i == Model.CurrentPage ? "bg-indigo-600 text-white" : "bg-white text-gray-600")">
                   @i
                </a>
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a href="@Url.Action("Liste", "Produit", new { page = Model.CurrentPage + 1 })"
                   class="px-6 py-3 bg-indigo-600 text-white rounded-lg shadow-md hover:bg-indigo-700 transition-all duration-300 ease-in-out transform hover:scale-105">
                   Suivant
                </a>
            }
        </div>
    </div>
</div>

<!-- CSS personnalisé -->
<style>
    .pagination a {
        transition: transform 0.2s ease-in-out, background-color 0.2s ease-in-out;
    }

    .pagination a:hover {
        transform: scale(1.1);
    }

    .pagination a:active {
        transform: scale(1);
    }

    tr:hover {
        background-color: #f5f5f5;
        transition: background-color 0.3s ease-in-out;
    }
</style>
