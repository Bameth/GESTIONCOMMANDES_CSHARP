@model GESTIONCOMMANDES.Models.Entities.Produit
@{
    Layout = "_Layout";
    ViewData["Title"] = "Détails du Produit";
}

<div class="container mx-auto mt-12 px-6 lg:px-16">
    <!-- Section principale -->
    <div class="flex flex-col lg:flex-row items-start gap-12">
        <!-- Colonne d'images -->
        <div class="lg:w-1/2 flex flex-col items-center">
            <!-- Image principale -->
            <div class="w-full h-96 mb-8">
                <img src="/produits/@Model.ImageFileName" alt="Image du produit"
                    class="w-full h-full object-cover rounded-xl shadow-lg">
            </div>
            <!-- Miniatures -->
            <div class="flex space-x-4">
                @for (int i = 0; i < 3; i++)
                {
                    <div
                        class="w-20 h-20 cursor-pointer border border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition duration-300">
                        <img src="/produits/@Model.ImageFileName" alt="Miniature" class="w-full h-full object-cover">
                    </div>
                }
            </div>
        </div>

        <!-- Colonne des détails -->
        <div class="lg:w-1/2">
            <!-- Titre et description -->
            <h1 class="text-4xl font-extrabold text-gray-900">@Model.Libelle</h1>
            <h2 class="text-lg text-gray-500 mt-4">Sac de sport - Petite taille (31 L)</h2>
            <p class="text-sm text-green-600 font-medium mt-4">En stock et prêt à expédier</p>

            <!-- Prix -->
            <div class="mt-6">
                <p class="text-4xl font-bold text-gray-800">@Model.Prix.ToString("C")</p>
                <p class="text-sm text-gray-400 line-through mt-2">CFA 115,300</p>
            </div>

            <!-- Boutons d'action -->
            <div class="flex space-x-6 mt-8">
                <a href="@Url.Action("AjouterAuPanier", "Produit", new { id = Model.Id })"
                    class="bg-gray-800 text-white text-lg px-8 py-3 rounded-lg shadow-md hover:bg-gray-400 transition duration-300">
                    Ajouter au panier
                </a>
                <button
                    class="border border-gray-300 text-lg px-8 py-3 rounded-lg shadow-md hover:border-gray-500 transition duration-300">
                    Ajouter aux favoris <i class="fas fa-heart mr-2"></i>
                </button>
            </div>

            <!-- Informations supplémentaires -->
            <div class="mt-12">
                <h3 class="text-2xl font-semibold text-gray-800">Détails du produit</h3>
                <p class="text-gray-600 mt-4 text-base leading-7">
                    Fabriqué à partir de matériaux durables, ce sac est parfait pour transporter vos affaires
                    lors de vos entraînements ou voyages. Compact mais spacieux, il offre un espace de stockage optimal.
                </p>
            </div>
        </div>
    </div>
</div>

<div id="popup" class="fixed top-10 right-10 w-96 bg-white p-6 rounded-lg shadow-xl hidden border border-gray-300">
    <div class="flex items-center gap-4">
        <img src="/produits/@Model.ImageFileName" alt="Produit ajouté" class="w-16 h-16 object-cover rounded-lg">
        <div>
            <h4 class="text-lg font-semibold text-gray-900">@Model.Libelle</h4>
            <p class="text-sm text-gray-500">Sac de sport - Petite taille (31 L)</p>
            <p class="text-xl font-bold text-red-800">@Model.Prix.ToString("C")</p>
        </div>
    </div>
    <div class="mt-4 flex justify-between gap-4">
        <a href="@Url.Action("Index", "Panier")"
            class="bg-gray-800 text-white w-full text-center py-2 rounded-lg hover:bg-gray-500 transition duration-300">Afficher
            le panier</a>
        <a href="@Url.Action("Payer", "Panier")"
            class="bg-white text-black w-full text-center py-2 rounded-lg border border-gray-300 hover:bg-gray-200 transition duration-300">Paiement</a>
    </div>
</div>

<script>
    function afficherPopup() {
        const popup = document.getElementById('popup');
        popup.classList.remove('hidden');
        popup.classList.add('show');
        setTimeout(() => {
            popup.classList.add('hide');
        }, 5000);
    }
</script>
@{
    if (TempData["ProduitAjoute"] != null)
    {
        <script>
            window.onload = function () {
                afficherPopup();  // Appel de la fonction pour afficher le popup
            }
        </script>
    }
}
<style>
    #popup {
        transition: opacity 0.3s ease, transform 0.3s ease;
    }

    #popup.show {
        opacity: 1;
        transform: translateY(0);
    }

    #popup.hide {
        opacity: 0;
        transform: translateY(-10px);
    }
</style>