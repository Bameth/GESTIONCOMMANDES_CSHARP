@model GESTIONCOMMANDES.Models.Entities.Produit
@{
    Layout = "_Layout";
    ViewData["Title"] = "Détails du Produit";
}
<link rel="stylesheet" href="~/css/details-produit.css" />
<div class="container mx-auto mt-16 px-6 lg:px-16">
    <!-- Section principale -->
    <div class="flex flex-col lg:flex-row items-start gap-16">
        <!-- Colonne d'images -->
        <div class="lg:w-1/2 flex flex-col lg:flex-row gap-8">
            <!-- Miniatures verticales -->
            <div class="flex flex-wrap gap-4 lg:flex-col lg:space-y-4">
                @foreach (var image in Model.Images)
                {
                    <div
                        class="w-20 h-20 cursor-pointer border border-gray-200 rounded-lg overflow-hidden transform transition-all duration-300 hover:scale-110 hover:shadow-lg">
                        <img src="/produits/@image" alt="@Model.Libelle" class="w-full h-full object-cover"
                            onclick="changerImagePrincipale(this)" onmouseover="changerImagePrincipale(this)">
                    </div>
                }
            </div>
            <!-- Image principale -->
            <div class="flex-1 mt-4 lg:mt-0">
                <div
                    class="w-full h-[500px] sm:h-[400px] md:h-[500px] lg:h-[500px] overflow-hidden relative rounded-xl shadow-xl transition-transform duration-500 ease-in-out hover:scale-105 hover:shadow-2xl">
                    <img id="imagePrincipale" src="/produits/@Model.ImageFileName" alt="Image du produit"
                        class="w-full h-full object-cover transition-transform transform hover:scale-110 duration-500 ease-in-out shadow-lg">
                </div>
            </div>
        </div>

        <!-- Colonne des détails -->
        <div class="lg:w-1/2 flex flex-col justify-between mt-6 lg:mt-0">
            <!-- Titre et description -->
            <h1 class="text-5xl font-extrabold text-gray-900 leading-tight mb-4">@Model.Libelle</h1>
            <p class="text-lg text-gray-700 mb-6">@Model.Description</p>

            <!-- Stock -->
            <div class="text-sm mt-4">
                @if (Model.QteStock > 0)
                {
                    <p class="text-green-600 font-medium">En stock et prêt à expédier</p>
                }
                else
                {
                    <p class="text-red-600 font-medium">Produit non disponible actuellement</p>
                }
            </div>

            <!-- Prix -->
            <div class="mt-6">
                @if (Model.PourcentageSolde.HasValue)
                {
                    <p class="text-4xl font-bold text-red-600">@Model.PrixSolde.ToString("C")</p>
                    <p class="text-sm text-gray-400 line-through mt-2">@Model.Prix.ToString("C")</p>
                }
                else
                {
                    <p class="text-4xl font-bold text-gray-800">@Model.Prix.ToString("C")</p>
                }
            </div>

            <!-- Boutons d'action -->
            <div class="flex flex-col sm:flex-row sm:space-x-4 space-y-4 sm:space-y-0 mt-8">
                @if (Model.QteStock > 0)
                {
                    <a href="@Url.Action("AjouterAuPanier", "Produit", new { id = Model.Id })"
                        class="flex justify-center items-center bg-gray-800 text-white text-lg px-8 py-3 rounded-lg shadow-md  w-full mb-6 sm:w-auto">
                        Ajouter au panier
                    </a>
                }
                else
                {
                    <button disabled
                        class="bg-gray-400 text-white text-lg px-8 py-3 rounded-lg shadow-md cursor-not-allowed w-full mb-6 sm:w-auto">
                        Indisponible
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<!-- Popup d'ajout au panier -->
<div id="popup"
    class="fixed top-10 right-10 w-96 bg-white p-6 rounded-lg shadow-2xl hidden border border-gray-300 transition-opacity duration-300 transform scale-95 hover:scale-100">
    <div class="flex items-center gap-4">
        <img src="/produits/@Model.ImageFileName" alt="Produit ajouté"
            class="w-16 h-16 object-cover rounded-lg shadow-lg">
        <div>
            <h4 class="text-lg font-semibold text-gray-900">@Model.Libelle</h4>
            <p class="text-sm text-gray-500">@Model.Description</p>
            <p class="text-xl font-bold text-red-800">@Model.Prix.ToString("C")</p>
        </div>
    </div>
    <div class="mt-4 flex justify-between gap-4">
        <a href="@Url.Action("Index", "Panier")"
            class="bg-gray-800 text-white w-full text-center py-2 rounded-lg hover:bg-gray-600 transition duration-300">Afficher
            le panier</a>
        <a href="@Url.Action("Payer", "Panier")"
            class="bg-white text-black w-full text-center py-2 rounded-lg border border-gray-300 hover:bg-gray-200 transition duration-300">Paiement</a>
    </div>
</div>

@if (TempData["ProduitAjoute"] != null)
{
    <script>
        window.onload = function () {
            afficherPopup();
            // Réinitialisation de TempData pour éviter la réapparition du popup
            TempData.Remove("ProduitAjoute");
        }
    </script>
}
<script src="~/js/details-produit.js"></script>
