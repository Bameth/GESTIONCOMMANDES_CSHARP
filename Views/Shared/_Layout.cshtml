<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - GESTIONCOMMANDES</title>

    <!-- Import des feuilles de style -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="https://unpkg.com/boxicons@2.1.1/css/boxicons.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
        integrity="sha512-..." crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/flowbite@2.5.2/dist/flowbite.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%);
        }

        /* Animation de fond pour le sidebar */
        .bg-animated {
            background: linear-gradient(90deg, rgba(59, 130, 246, 1) 0%, rgba(96, 165, 250, 1) 50%, rgba(139, 92, 246, 1) 100%);
            background-size: 300% 300%;
            animation: gradientBG 6s ease infinite;
        }

        /* Navbar */
        nav {
            z-index: 1000;
        }

        /* Animation du menu utilisateur */
        #userMenu {
            display: none;
        }

        #userMenu.show {
            display: block;
        }

        .sidebar-item {
            transition: transform 0.3s ease, background-color 0.3s ease;
        }

        .sidebar-item:hover {
            background-color: rgba(255, 255, 255, 0.2);
        }

        .gradient-header {
            background: linear-gradient(to right, #4facfe, #00f2fe);
            height: 5px;
            border-radius: 5px;
            margin-bottom: 20px;
        }
    </style>
    <script>
        function toggleUserMenu() {
            const menu = document.getElementById('userMenu');
            menu.classList.toggle('show');
        }
    </script>
</head>

<body class="bg-gray-50 text-gray-900">

    <!-- Navbar -->
    <nav
        class="bg-gradient-to-r from-blue-600 to-indigo-600 shadow-xl p-4 flex justify-between items-center fixed w-full z-10">
        <div class="flex items-center space-x-4">
            <svg class="h-8 w-8 text-white transition-transform transform hover:scale-125"
                xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M12 2c1.054 0 2.052.816 2.05 1.926v16.148c0 1.106-.992 1.926-2.05 1.926s-2.05-.82-2.05-1.926V3.926C9.948 2.816 10.946 2 12 2z" />
            </svg>
            <h1 class="text-2xl font-extrabold text-white">Gestion Boutique</h1>
        </div>

        <!-- Menu Utilisateur -->
        <div class="relative">
            <img src="https://via.placeholder.com/40" alt="User Photo"
                class="rounded-full cursor-pointer hover:shadow-lg transition-transform transform hover:scale-110"
                onclick="toggleUserMenu()">
            <div id="userMenu" class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-2 z-20">
                <a href="#" class="block px-4 py-2 text-gray-800 hover:bg-gray-100">Profil</a>
                <a href="#" class="block px-4 py-2 text-gray-800 hover:bg-gray-100">Paramètres</a>
                <a href="#" class="block px-4 py-2 text-gray-800 hover:bg-gray-100">Déconnexion</a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="flex h-screen pt-16">
        <!-- Sidebar -->
        <aside class="w-64 bg-animated text-white p-6 shadow-xl fixed h-full transition-all">
            <nav class="space-y-4">
                <a href="#"
                    class="sidebar-item text-lg font-semibold p-3 rounded-lg flex items-center hover:bg-white hover:bg-opacity-20 transition duration-200 transform hover:translate-x-1">
                    <i class="fas fa-tachometer-alt mr-3"></i> Dashboard
                </a>
                <a href="@Url.Action("Index", "Client")"
                    class="sidebar-item text-lg font-semibold p-3 rounded-lg flex items-center hover:bg-white hover:bg-opacity-20 transition duration-200 transform hover:translate-x-1">
                    <i class="fas fa-user-friends mr-3"></i> Clients
                </a>
                <a href="@Url.Action("Index", "Commande")"
                    class="sidebar-item text-lg font-semibold p-3 rounded-lg flex items-center hover:bg-white hover:bg-opacity-20 transition duration-200 transform hover:translate-x-1">
                    <i class="fas fa-box-open mr-3"></i> Commandes
                </a>
                <a href="@Url.Action("Index","Produit")"
                    class="sidebar-item text-lg font-semibold p-3 rounded-lg flex items-center hover:bg-white hover:bg-opacity-20 transition duration-200 transform hover:translate-x-1">
                    <i class="fas fa-shopping-cart mr-3"></i> Produit
                </a>
                <a href="@Url.Action("Index", "Panier")"
                    class="sidebar-item text-lg font-semibold p-3 rounded-lg flex items-center hover:bg-white hover:bg-opacity-20 transition duration-200 transform hover:translate-x-1">
                    <i class="fas fa-shopping-cart mr-3"></i>
                    Panier
                    <span id="cart-count" class="ml-2 text-sm bg-red-500 text-white rounded-full px-2 py-1"></span>
                </a>
                <a href="@Url.Action("Liste", "Produit")"
                    class="sidebar-item text-lg font-semibold p-3 rounded-lg flex items-center hover:bg-white hover:bg-opacity-20 transition duration-200 transform hover:translate-x-1">
                    <i class="fas fa-shopping-cart mr-3"></i>
                    Liste Product
                </a>

                <partial name="_LoginPartial" />
            </nav>
        </aside>

        <!-- Main Content Area -->
        <main class="flex-1 ml-64 p-10 bg-gray-100 rounded-tl-3xl shadow-inner relative">
            <div class="gradient-header"></div>
            <div class="h-full overflow-y-auto">
                @RenderBody() <!-- Contenu spécifique à chaque page -->
            </div>
        </main>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/flowbite@2.5.2/dist/flowbite.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>

</html>
<script>
    // Fonction pour mettre à jour le compteur du panier
    function updateCartCount() {
        fetch('@Url.Action("CountArticles", "Panier")')
            .then(response => response.json())
            .then(count => {
                const cartCountElement = document.getElementById('cart-count');
                cartCountElement.textContent = count > 0 ? count : '0'; // Si 0, ne rien afficher
            })
            .catch(error => console.error('Error:', error));
    }

    // Appel de la fonction lors du chargement de la page
    document.addEventListener('DOMContentLoaded', updateCartCount);
</script>
