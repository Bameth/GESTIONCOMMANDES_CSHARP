@model GESTIONCOMMANDES.Models.Entities.Commande
@using GESTIONCOMMANDES.Models.Entities
@using Microsoft.EntityFrameworkCore
@using GESTIONCOMMANDES.enums
@inject GESTIONCOMMANDES.data.AppDbContext _context

@{
    Layout = "_Layout";
    ViewData["Title"] = "Détails de la Commande";
    var userName = User.Identity?.Name;
    var user = await _context.Users.FirstOrDefaultAsync(u => u.UserName == userName);
}

<div class="min-h-screen bg-gradient-to-br from-purple-50 via-white to-purple-50 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-3xl shadow-2xl overflow-hidden">
            <!-- Header Section -->
            <div class="bg-gradient-to-r from-purple-600 to-indigo-600 p-8">
                <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                    <h1 class="text-3xl md:text-4xl font-bold text-white">
                        <i class="fas fa-shopping-bag mr-3"></i>
                        Commande #@Model.Id
                    </h1>
                    <div class="flex items-center space-x-2 rounded-full px-4 py-2">
                        <span class="text-black">Client:</span>
                        <span class="font-semibold text-black">
                            @(Model.Client?.Nom ?? "Nom Inconnu") @(Model.Client?.Prenom ?? "Prénom Inconnu")
                        </span>
                    </div>
                </div>
            </div>

            <!-- Order Status Banner -->
            <div class="bg-gray-50 px-8 py-4 border-b border-gray-100">
                <div class="flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center space-x-4">
                        @if (Model.EtatCommande == StatutCommande.LIVREE)
                        {
                            <span class="inline-flex items-center px-4 py-2 rounded-full bg-green-100 text-green-800">
                                <i class="fas fa-check-circle mr-2"></i> Commande Livrée
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center px-4 py-2 rounded-full bg-yellow-100 text-yellow-800">
                                <i class="fas fa-clock mr-2"></i> En Attente de Livreur
                            </span>
                        }
                        @if (Model.StatutPaiement == StatutPaiement.PAYEE)
                        {
                            <span class="inline-flex items-center px-4 py-2 rounded-full bg-green-100 text-green-800">
                                <i class="fas fa-check-circle mr-2"></i> Payée
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center px-4 py-2 rounded-full bg-red-100 text-red-800">
                                <i class="fas fa-exclamation-circle mr-2"></i> Non Payée
                            </span>
                        }
                    </div>
                    <div class="text-2xl font-bold text-gray-900">
                        @Model.MontantTotal.ToString("C")
                    </div>
                </div>
            </div>

            <!-- Order Details Grid -->
            <div class="p-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <!-- Date Information -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                    <h3 class="text-gray-500 text-sm font-medium mb-2">Date de Commande</h3>
                    <p class="text-lg font-semibold text-gray-900">@Model.Date.ToString("dd/MM/yyyy HH:mm")</p>
                </div>

                <!-- Delivery Information -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                    <h3 class="text-gray-500 text-sm font-medium mb-2">Livreur</h3>
                    <p class="text-lg font-semibold text-gray-900">
                        @(Model.Livraison?.Livreur?.Nom ?? "Non attribué")
                    </p>
                </div>

                <!-- Delivery Date -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow">
                    <h3 class="text-gray-500 text-sm font-medium mb-2">Date de Livraison</h3>
                    <p class="text-lg font-semibold text-gray-900">
                        @(Model.Livraison != null ? Model.Livraison.DateLivraison.ToString("dd/MM/yyyy HH:mm") : "Non planifiée")
                    </p>
                </div>

                <!-- Address -->
                <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 hover:shadow-md transition-shadow col-span-full">
                    <h3 class="text-gray-500 text-sm font-medium mb-2">Adresse de Livraison</h3>
                    <p class="text-lg font-semibold text-gray-900">@Model.Client.Adresse</p>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="px-8 pb-8 flex flex-wrap justify-end gap-4">
                @if (user.Role == Role.RS)
                {
                    <button onclick="openLivraisonModal()" 
                            class="inline-flex items-center px-6 py-3 rounded-xl bg-indigo-600 text-white hover:bg-indigo-700 transition-colors shadow-lg hover:shadow-xl">
                        <i class="fas fa-user-plus mr-2"></i> Attribuer un Livreur
                    </button>
                }

                @if (user.Role == Role.CLIENT && Model.Livraison != null && Model.StatutPaiement != StatutPaiement.PAYEE)
                {
                    <button onclick="openPaiementModal()"
                            class="inline-flex items-center px-6 py-3 rounded-xl bg-green-600 text-white hover:bg-green-700 transition-colors shadow-lg hover:shadow-xl">
                        <i class="fas fa-wallet mr-2"></i> Procéder au Paiement
                    </button>
                }
            </div>
        </div>
    </div>

    <!-- Payment Modal -->
    <div id="paiementModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50">
        <div class="min-h-screen flex items-center justify-center p-4">
            <div class="bg-white rounded-3xl shadow-2xl max-w-2xl w-full p-8 transform transition-all">
                <h2 class="text-3xl font-bold text-gray-900 mb-8 text-center">Choisissez votre Mode de Paiement</h2>

                <!-- Payment Summary -->
                <div class="bg-gray-50 rounded-2xl p-6 mb-8">
                    <div class="flex justify-between items-center">
                        <span class="text-gray-600">Montant Total:</span>
                        <span class="text-2xl font-bold text-gray-900">@Model.MontantTotal.ToString("C")</span>
                    </div>
                </div>

                <!-- Payment Methods -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                    <div onclick="selectPaymentMethod('OM')" 
                         class="relative bg-white rounded-2xl p-6 border-2 border-gray-200 hover:border-indigo-500 cursor-pointer transition-all hover:shadow-lg group">
                        <div class="flex flex-col items-center">
                            <img src="~/images/OM.png" alt="Orange Money" class="w-20 h-20 object-contain mb-4" />
                            <span class="font-semibold text-gray-900">Orange Money</span>
                        </div>
                    </div>

                    <div onclick="selectPaymentMethod('WAVE')"
                         class="relative bg-white rounded-2xl p-6 border-2 border-gray-200 hover:border-indigo-500 cursor-pointer transition-all hover:shadow-lg group">
                        <div class="flex flex-col items-center">
                            <img src="~/images/wave.png" alt="Wave" class="w-20 h-20 object-contain mb-4" />
                            <span class="font-semibold text-gray-900">Wave</span>
                        </div>
                    </div>

                    <div onclick="selectPaymentMethod('ESPECES')"
                         class="relative bg-white rounded-2xl p-6 border-2 border-gray-200 hover:border-indigo-500 cursor-pointer transition-all hover:shadow-lg group">
                        <div class="flex flex-col items-center">
                            <img src="~/images/espece.png" alt="Espèces" class="w-20 h-20 object-contain mb-4" />
                            <span class="font-semibold text-gray-900">Espèces</span>
                        </div>
                    </div>
                </div>

                <!-- Payment Form -->
                <form asp-action="Paiement" asp-controller="Commande" method="post" onsubmit="return validatePaymentSelection()" class="space-y-6">
                    <input type="hidden" name="commandeId" value="@Model.Id" />
                    <input type="hidden" id="selectedPaymentType" name="typePaiement" />
                    <input type="hidden" id="reference" name="reference" required />

                    <!-- Dynamic Payment Forms -->
                    <div id="omForm" class="hidden space-y-4">
                        <label class="block">
                            <span class="text-gray-700">Numéro Orange Money</span>
                            <input type="text" id="numOM" name="numOM" 
                                   class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
                        </label>
                    </div>

                    <div id="waveForm" class="hidden space-y-4">
                        <label class="block">
                            <span class="text-gray-700">Numéro Wave</span>
                            <input type="text" id="numWave" name="numWave"
                                   class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
                        </label>
                    </div>

                    <div id="espForm" class="hidden space-y-4">
                        <label class="block">
                            <span class="text-gray-700">Montant</span>
                            <input type="number" id="montantEsp" name="montantEsp"
                                   class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" />
                        </label>
                    </div>

                    <div class="flex justify-end space-x-4">
                        <button type="button" onclick="closePaiementModal()"
                                class="px-6 py-3 rounded-xl bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
                            Annuler
                        </button>
                        <button type="submit" id="submitPaymentButton"
                                class="px-6 py-3 rounded-xl bg-green-600 text-white hover:bg-green-700 transition-colors">
                            Confirmer le Paiement
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Delivery Modal -->
    <div id="livraisonModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50">
        <div class="min-h-screen flex items-center justify-center p-4">
            <div class="bg-white rounded-3xl shadow-2xl max-w-md w-full p-8">
                <h2 class="text-2xl font-bold text-gray-900 mb-6">Planifier la Livraison</h2>
                
                <form asp-route-commandeId="@Model.Id" method="post" asp-controller="Commande" asp-action="PlanifierLivraison" class="space-y-6">
                    <input type="hidden" name="commandeId" value="@Model.Id" />
                    
                    <div>
                        <label for="LivreurId" class="block text-sm font-medium text-gray-700">Livreur</label>
                        <select name="livreurId" id="LivreurId" 
                                class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500">
                            @foreach (var livreur in (List<Livreur>)ViewData["Livreurs"])
                            {
                                <option value="@livreur.Id">@livreur.Nom</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label for="DateLivraison" class="block text-sm font-medium text-gray-700">Date de Livraison</label>
                        <input type="datetime-local" name="dateLivraison" id="DateLivraison"
                               class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" required />
                    </div>

                    <div>
                        <label for="adresse" class="block text-sm font-medium text-gray-700">Adresse</label>
                        <input type="text" name="adresse" id="adresse"
                               class="mt-1 block w-full rounded-xl border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" required />
                    </div>

                    <div class="flex justify-end space-x-4">
                        <button type="button" onclick="closeLivraisonModal()"
                                class="px-6 py-3 rounded-xl bg-gray-100 text-class="px-6 py-3 rounded-xl bg-gray-100 text-gray-700 hover:bg-gray-200 transition-colors">
                            Annuler
                        </button>
                        <button type="submit"
                                class="px-6 py-3 rounded-xl bg-indigo-600 text-white hover:bg-indigo-700 transition-colors">
                            Planifier la Livraison
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/detailsCommande.js"></script>
}