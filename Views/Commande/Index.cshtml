@model IEnumerable<GESTIONCOMMANDES.Models.Entities.Commande>

@{
    ViewData["Title"] = "Gestion des Commandes";

    // Calcul des statistiques
    var totalCommandes = Model.Count();
    var montantTotal = Model.Sum(c => c.MontantTotal);
    var montantMoyenne = totalCommandes > 0 ? montantTotal / totalCommandes : 0;
}

<div class="min-h-screen bg-gradient-to-r from-purple-100 to-indigo-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <!-- Header Section -->
        <div class="text-center mb-12">
            <h1 class="text-5xl font-extrabold text-indigo-900 mb-4">
                Gestion des Commandes
            </h1>
            <p class="text-xl text-gray-600">
                Visualisez, gérez et suivez vos commandes en un seul endroit
            </p>
        </div>

        <!-- Statistics Section -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
            <div class="bg-white rounded-xl p-8 shadow-lg hover:shadow-xl transition-shadow duration-300 border-l-4 border-indigo-500 mb-6 md:mb-0">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-gray-600 font-medium">Total Commandes</span>
                    <span class="w-12 h-12 bg-indigo-50 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                        </svg>
                    </span>
                </div>
                <p class="text-3xl font-bold text-indigo-900">@totalCommandes</p>
            </div>

            <div class="bg-white rounded-xl p-8 shadow-lg hover:shadow-xl transition-shadow duration-300 border-l-4 border-green-500 mb-6 md:mb-0">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-gray-600 font-medium">Montant Total</span>
                    <span class="w-12 h-12 bg-green-50 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </span>
                </div>
                <p class="text-3xl font-bold text-green-900">
                    @montantTotal.ToString("C")
                </p>
            </div>

            <div class="bg-white rounded-xl p-8 shadow-lg hover:shadow-xl transition-shadow duration-300 border-l-4 border-purple-500">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-gray-600 font-medium">Montant Moyen</span>
                    <span class="w-12 h-12 bg-purple-50 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2" />
                        </svg>
                    </span>
                </div>
                <p class="text-3xl font-bold text-purple-900">
                    @montantMoyenne.ToString("C")
                </p>
            </div>
        </div>

        <!-- Command Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model)
                {
                    <div class="bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 mb-6">
                        <!-- Card Header -->
                        <div class="p-6 border-b border-gray-100">
                            <div class="flex justify-between items-center mb-4">
                                <h3 class="text-lg font-semibold text-gray-900">
                                    @((item.Client?.Nom ?? "") + " " + (item.Client?.Prenom ?? ""))
                                </h3>
                                <span class="text-sm text-gray-500">
                                    @item.Date.ToString("dd/MM/yyyy")
                                </span>
                            </div>
                            <p class="text-2xl font-bold text-gray-900 mb-6">
                                @item.MontantTotal.ToString("C")
                            </p>
                            <div class="flex gap-4">
                                <a href="@Url.Action("Details", "Commande", new { id = item.Id })"
                                   class="flex-1 bg-indigo-600 text-white px-4 py-2 rounded-lg hover:bg-indigo-500 transition-colors duration-200">
                                    <i class="fas fa-info-circle mr-2"></i>Détails
                                </a>
                                <button class="w-10 h-10 flex items-center justify-center rounded-lg border border-red-500 hover:border-red-300 hover:text-red-500 transition-colors duration-200">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-span-full bg-white rounded-xl p-12 text-center shadow-lg">
                    <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                        <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                        </svg>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">Aucune commande</h3>
                    <p class="text-gray-500">Vous n'avez pas encore de commande à afficher.</p>
                </div>
            }
        </div>
    </div>
</div>
