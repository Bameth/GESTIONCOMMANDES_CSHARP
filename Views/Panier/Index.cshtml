@model IList<GESTIONCOMMANDES.Models.Entities.LignePanier>
@{
    ViewData["Title"] = "Panier";
    Layout = "_Layout";
}

<section class="min-h-screen bg-gray-50 py-12 dark:bg-gray-900">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between">
            <h1 class="flex items-center gap-3 text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
                <i class="fas fa-shopping-bag h-8 w-8 text-red-600"></i>
                Votre Panier
            </h1>
            <div id="cartStatus" class="hidden items-center text-sm text-gray-500 dark:text-gray-400">
                <i class="fas fa-spinner fa-spin mr-2"></i>
                Mise à jour...
            </div>
        </div>

        <div id="cartContent" class="relative">
            @if (Model.Any())
            {
                <div class="mt-12 lg:grid lg:grid-cols-12 lg:gap-x-12 lg:items-start">
                    <div class="lg:col-span-7">
                        <div class="space-y-6" id="cartItems">
                            @foreach (var item in Model)
                            {
                                <div class="group relative flex gap-6 rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-all hover:shadow-md dark:border-gray-800 dark:bg-gray-800"
                                    data-item-id="@item.Id"
                                    data-item-price="@item.Produit.Prix"
                                    data-item-discount="@item.Produit.PourcentageSolde">
                                    <a href="@Url.Action("Details", "Produit", new { id = item.Produit.Id })" 
                                       class="aspect-square h-24 w-24 flex-none overflow-hidden rounded-lg bg-gray-100">
                                        <img src="/produits/@item.Produit.ImageFileName" 
                                             alt="@item.Produit.Libelle"
                                             class="h-full w-full object-cover object-center" />
                                    </a>

                                    <div class="flex flex-1 flex-col">
                                        <div class="flex justify-between">
                                            <h3 class="text-lg font-medium text-gray-900 dark:text-white">
                                                @item.Produit.Libelle
                                            </h3>
                                            <p class="text-lg font-medium text-gray-900 dark:text-white item-total"
                                               data-item-id="@item.Id">
                                                @item.Montant().ToString("C")
                                            </p>
                                        </div>

                                        <div class="mt-4 flex items-center gap-4">
                                            <div class="flex items-center rounded-lg border border-gray-200 dark:border-gray-700">
                                                <form asp-action="ModifierQuantite" method="post" class="inline-block quantity-form">
                                                    <input type="hidden" name="ligneId" value="@item.Id" />
                                                    <input type="hidden" name="increment" value="-1" />
                                                    <button type="submit" 
                                                            class="flex h-10 w-10 items-center justify-center border-r border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors duration-200">
                                                        @if (item.Quantite == 1)
                                                        {
                                                            <i class="fas fa-trash text-red-600 h-4 w-4 transition-all duration-200"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="fas fa-minus text-gray-600 h-4 w-4 transition-all duration-200"></i>
                                                        }
                                                    </button>
                                                </form>

                                                <input type="text" 
                                                       class="w-12 border-none bg-transparent text-center text-sm font-medium text-gray-900 focus:outline-none dark:text-white quantity-input" 
                                                       value="@item.Quantite" 
                                                       readonly />

                                                <form asp-action="ModifierQuantite" method="post" class="inline-block quantity-form">
                                                    <input type="hidden" name="ligneId" value="@item.Id" />
                                                    <input type="hidden" name="increment" value="1" />
                                                    <button type="submit" 
                                                            class="flex h-10 w-10 items-center justify-center border-l border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors duration-200">
                                                        <i class="fas fa-plus text-gray-600 h-4 w-4 transition-all duration-200"></i>
                                                    </button>
                                                </form>
                                            </div>
                                            <p class="text-sm text-gray-500 dark:text-gray-400">
                                                Prix unitaire: <span class="text-gray-900 dark:text-white">@item.Produit.Prix.ToString("C")</span>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mt-16 rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-800 dark:bg-gray-800 lg:col-span-5 lg:mt-0" id="orderSummary">
                        <h2 class="text-lg font-medium text-gray-900 dark:text-white">
                            Résumé de la commande
                        </h2>

                        <dl class="mt-6 space-y-4">
                            
                            <div class="flex items-center justify-between">
                                <dt class="text-sm text-gray-600 dark:text-gray-400">Frais de livraison</dt>
                                <dd class="text-sm font-medium text-gray-900 dark:text-white">Gratuit</dd>
                            </div>
                            <div class="border-t border-gray-200 pt-4 dark:border-gray-700">
                                <div class="flex items-center justify-between">
                                    <dt class="text-base font-medium text-gray-900 dark:text-white">Total</dt>
                                    <dd class="text-base font-medium text-red-600 dark:text-red-400" id="totalPanier">
                                        @ViewBag.Total.ToString("C")
                                    </dd>
                                </div>
                            </div>
                        </dl>

                        @if (@ViewBag.nombreCommandes >= 10)
                        {
                            <p class="mt-4 text-sm text-green-600 flex items-center">
                                <i class="fas fa-check-circle mr-2"></i>
                                Une remise de 10% a été appliquée à votre commande
                            </p>
                        }

                        <a href="@Url.Action("PasserCommande", "Commande")" 
                           class="mt-6 flex w-full items-center justify-center rounded-xl bg-black px-6 py-4 text-base font-medium text-white shadow-sm hover:bg-gray-900 focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2 dark:bg-white dark:text-black dark:hover:bg-gray-100 transition-all duration-200">
                            <i class="fas fa-arrow-right mr-2"></i> Commander
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="mt-12 text-center" id="emptyCart">
                    <div class="rounded-full bg-gray-100 p-6 w-24 h-24 mx-auto flex items-center justify-center dark:bg-gray-800">
                        <i class="fas fa-shopping-bag text-4xl text-gray-400"></i>
                    </div>
                    <h3 class="mt-4 text-lg font-medium text-gray-900 dark:text-white">
                        Votre panier est vide
                    </h3>
                    <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
                        Commencez votre shopping en parcourant notre collection.
                    </p>
                    <a href="@Url.Action("Index", "Produit")" 
                       class="mt-6 inline-flex items-center rounded-xl bg-black px-6 py-3 text-base font-medium text-white shadow-sm hover:bg-gray-900 focus:outline-none focus:ring-2 focus:ring-black focus:ring-offset-2 dark:bg-white dark:text-black dark:hover:bg-gray-100 transition-all duration-200">
                        <i class="fas fa-shopping-bag mr-2"></i> Parcourir les produits
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<div id="notification" class="fixed bottom-4 right-4 transform translate-y-full opacity-0 transition-all duration-300 ease-out">
    <div class="bg-green-500 text-white px-6 py-3 rounded-lg shadow-lg flex items-center">
        <i class="fas fa-check-circle mr-2"></i>
        <span id="notificationMessage"></span>
    </div>
</div>

<script src="/js/panier.js"></script>