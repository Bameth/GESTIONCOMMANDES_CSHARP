@model GESTIONCOMMANDES.Models.Entities.Client

@{
    ViewData["Title"] = "Détails du Client";
}

<div class="bg-gradient-to-br from-indigo-200 to-blue-300 min-h-screen py-6">
    <div class="max-w-7xl mx-auto bg-white shadow-xl rounded-xl p-8">

        <!-- Cadre des informations du client -->
        <div
            class="bg-gradient-to-r from-blue-600 to-indigo-600 p-8 rounded-3xl shadow-2xl mb-8 transform transition-all hover:scale-105 duration-300 ease-in-out">
            <div class="flex items-center justify-between space-x-8">
                <div class="flex items-center space-x-6">
                    <div
                        class="p-6 bg-white rounded-full shadow-xl transform transition-all hover:scale-110 duration-300 ease-in-out">
                        <svg class="h-16 w-16 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                            xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M16.07 13a4 4 0 00-7.04 0m7.04 0A8 8 0 018.93 21m7.14 0A8 8 0 015.93 13m10.14 0a4 4 0 00-7.04 0M16.07 13A8 8 0 015.93 21m7.14 0A8 8 0 0116.07 13m-4-6a4 4 0 118 0 4 4 0 01-8 0z" />
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-white text-4xl font-semibold hover:text-indigo-100 transition-all ease-in-out">
                            @Model.Nom @Model.Prenom</h2>
                        <p class="text-white text-xl">Téléphone : @Model.Telephone</p>
                    </div>
                </div>

                <div class="space-x-6 text-white text-lg">
                    <div class="flex items-center">
                        <svg class="h-7 w-7 mr-2 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                            xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17 9V5a4 4 0 00-8 0v4M3 13h18m-9 0v8m0 0l-3-3m3 3l3-3" />
                        </svg>
                        Solde actuel : <span class="font-bold text-2xl">@Model.Solde.ToString("C")</span>
                    </div>
                    <div class="flex items-center">
                        <svg class="h-7 w-7 mr-2 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                            xmlns="http://www.w3.org/2000/svg">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        Adresse : @Model.Adresse
                    </div>
                </div>
            </div>
        </div>

        <!-- Formulaire de filtrage -->
        <form method="get" action="@Url.Action("Details", "Client", new { id = Model.Id })"
            class="flex items-center bg-gray-100 p-4 rounded-lg shadow-lg space-x-4 mb-8">
            <div class="flex-grow">
                <div class="relative">
                    <select name="etatFilter"
                        class="border border-gray-300 rounded-lg pl-12 pr-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 w-full transition-all">
                        <option value="all" selected>Tous les États</option>
                        <option value="ANNULEE">Annulée</option>
                        <option value="ENCOURS">En cours</option>
                        <option value="LIVREE">Livrée</option>
                    </select>
                </div>
            </div>
            <button type="submit"
                class="px-6 py-3 bg-blue-600 text-white rounded-lg shadow-lg hover:bg-blue-700 transition-colors mt-0">
                <i class="fas fa-search mr-2"></i> Filtrer
            </button>
        </form>

        <!-- Liste des commandes du client -->
        <div class="mb-8">
            <div class="overflow-x-auto rounded-3xl shadow-xl mt-8">
                <table class="min-w-full table-auto bg-white rounded-lg shadow-lg">
                    <thead
                        class="bg-gradient-to-r from-blue-600 to-blue-800 text-white uppercase text-xs font-semibold">
                        <tr>
                            <th class="px-6 py-4 text-center">Date Commande</th>
                            <th class="px-6 py-4 text-center">Montant Total</th>
                            <th class="px-6 py-4 text-center">Paiement</th>
                            <th class="px-6 py-4 text-center">Date Livraison</th>
                            <th class="px-6 py-4 text-center">État Commande</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-700">
                        @foreach (var commande in Model.Commandes)
                        {
                            <tr class="hover:bg-indigo-100 transition-all">
                                <td class="px-6 py-3 text-center">@commande.Date.ToString("dd/MM/yyyy")</td>
                                <td class="px-6 py-3 text-center">@commande.MontantTotal.ToString("C")</td>
                                <td class="px-6 py-3 text-center">
                                    @if (commande.StatutPaiement != null)
                                    {
                                        @switch (commande.StatutPaiement)
                                        {
                                            case GESTIONCOMMANDES.enums.StatutPaiement.PAYEE:
                                                <span class="text-green-500 font-semibold">Payée</span>
                                                break;
                                            default:
                                                <span class="text-gray-500">Statut inconnu</span>
                                                break;
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-red-500 font-semibold">Non payée</span>

                                    }
                                </td>

                                <td class="px-6 py-3 text-center">
                                    @if (commande.Livraison != null)
                                    {
                                        @commande.Livraison.DateLivraison.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-gray-500">Commande pas encore livrée</span>
                                    }
                                </td>

                                <td class="px-6 py-3 text-center">
                                    @switch (commande.EtatCommande)
                                    {
                                        case GESTIONCOMMANDES.enums.StatutCommande.LIVREE:
                                            <i class="fas fa-truck-loading text-green-500"></i> <span
                                                class="text-green-500 font-semibold">LIVREE</span>
                                            break;
                                        case GESTIONCOMMANDES.enums.StatutCommande.PRET_A_LIVRER:
                                            <i class="fas fa-spinner text-yellow-500 animate-spin"></i> <span
                                                class="text-yellow-500 font-semibold">En cours Livraison</span>
                                            break;
                                        case GESTIONCOMMANDES.enums.StatutCommande.ANNULEE:
                                            <i class="fas fa-ban text-red-500"></i> <span
                                                class="text-red-500 font-semibold">Annulée</span>
                                            break;
                                        case GESTIONCOMMANDES.enums.StatutCommande.ENATTENTE:
                                            <i class="fas fa-ban text-red-500"></i> <span class="text-red-500 font-semibold">EN
                                                ATTENTE</span>
                                            break;
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
