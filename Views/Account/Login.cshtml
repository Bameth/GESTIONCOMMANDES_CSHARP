@using GESTIONCOMMANDES.Models.Entities;
@model LoginViewModel;
@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="flex items-center justify-center min-h-screen">
    <div class="flex w-3/4 max-w-4xl bg-white rounded-lg shadow-lg">
        <!-- Section de bienvenue -->
        <div class="w-1/2 bg-blue-500 text-white p-8 flex flex-col justify-center rounded-l-lg">
            <h2 class="text-3xl font-bold mb-4">Hello, Welcome!</h2>
            <p class="mb-6">Don't have an account?</p>
            <a asp-controller="Account" asp-action="Register" class="px-6 py-2 border border-white text-white rounded-lg hover:bg-white hover:text-blue-500">
                Register
            </a>
            <a asp-controller="Home" asp-action="Index" class="mt-6 px-6 py-2 border border-white text-white rounded-lg hover:bg-white hover:text-blue-500">
                Return Home
            </a>
        </div>

        <!-- Formulaire de connexion -->
        <div class="w-1/2 p-8 flex flex-col justify-center">
            <h2 class="text-2xl font-bold mb-4 text-gray-800">Login</h2>
            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-red-500 mb-6"></div>

                <!-- Email Input -->
                <div class="mb-4">
                    <label asp-for="Email" class="sr-only">Email</label>
                    <div class="relative">
                        <input type="text" name="Email" id="Email" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" asp-for="Email" placeholder="Enter your email" />
                        <span class="absolute inset-y-0 right-3 flex items-center text-gray-400">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9A3.75 3.75 0 1112 5.25 3.75 3.75 0 0115.75 9zM21 21l-4.35-4.35" />
                            </svg>
                        </span>
                    </div>
                </div>

                <!-- Password Input -->
                <div class="mb-4">
                    <label asp-for="Password" class="sr-only">Password</label>
                    <div class="relative">
                        <input type="password" name="Password" id="Password" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500" asp-for="Password" placeholder="Enter your password" />
                        <span class="absolute inset-y-0 right-3 flex items-center text-gray-400">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5v-1.125a4.125 4.125 0 00-8.25 0V10.5M4.5 10.5H19.5M6 10.5v6.375a3.375 3.375 0 003.375 3.375h5.25A3.375 3.375 0 0018 16.875V10.5M9 15h.008v.008H9v-.008zm6 0h.008v.008H15v-.008z" />
                            </svg>
                        </span>
                    </div>
                </div>

                <!-- Forgot password -->
                <div class="mb-4 text-right">
                    <a asp-controller="Account" asp-action="ForgotPassword" class="text-sm text-blue-500 hover:underline">Forgot password?</a>
                </div>

                <!-- Login Button -->
                <button type="submit" class="w-full px-4 py-2 bg-blue-500 text-white rounded-lg hover:bg-blue-600 focus:outline-none">
                    Login
                </button>
            </form>

            <!-- Connexion avec des réseaux sociaux -->
            <div class="mt-6 text-center">
                <p class="text-gray-600 text-sm mb-4">or login with social platforms</p>
                <div class="flex justify-center space-x-4">
                    <button class="p-3 bg-gray-100 rounded-full hover:bg-gray-200">
                        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/google/google-original.svg" class="w-5 h-5" />
                    </button>
                    <button class="p-3 bg-gray-100 rounded-full hover:bg-gray-200">
                        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/facebook/facebook-original.svg" class="w-5 h-5" />
                    </button>
                    <button class="p-3 bg-gray-100 rounded-full hover:bg-gray-200">
                        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/github/github-original.svg" class="w-5 h-5" />
                    </button>
                    <button class="p-3 bg-gray-100 rounded-full hover:bg-gray-200">
                        <img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/linkedin/linkedin-original.svg" class="w-5 h-5" />
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}
