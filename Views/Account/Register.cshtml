@using GESTIONCOMMANDES.Models.Entities;
@model RegisterViewModel;
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<div class="flex items-center justify-center min-h-screen bg-gradient-to-r from-blue-100 via-indigo-100 to-green-100">
    <div class="flex w-full max-w-4xl bg-white rounded-lg shadow-lg">
        <!-- Section de bienvenue -->
        <div class="w-1/2 bg-blue-500 text-white p-10 flex flex-col justify-center rounded-l-lg">
            <h2 class="text-4xl font-bold mb-6">Bienvenue!</h2>
            <p class="mb-8">Vous avez déjà un compte?</p>
            <a asp-controller="Account" asp-action="Login" class="px-6 py-3 border border-white text-white rounded-lg hover:bg-white hover:text-blue-500 transition-all duration-300">
                Se connecter
            </a>
        </div>

        <!-- Formulaire d'inscription -->
        <div class="w-1/2 p-10 flex flex-col justify-center">
            <h2 class="text-3xl font-bold mb-6 text-gray-800">Créer un compte</h2>
            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-red-500 mb-8"></div>

                <!-- Nom & Prénom -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-10 mb-10">
                    <div class="mb-8">
                        <label asp-for="Nom" class="block text-xl font-semibold text-gray-800 mb-4">Nom</label>
                        <div class="relative">
                            <input type="text" name="Nom" id="Nom" class="w-full p-5 pl-14 focus:ring-2 focus:ring-indigo-500 border-2 border-gray-300 rounded-xl transition-all duration-300 placeholder-gray-400 focus:border-indigo-500" asp-for="Nom" placeholder="Entrez votre nom" />
                            <i class="fas fa-user absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500"></i>
                        </div>
                        <span asp-validation-for="Nom" class="text-red-500 text-sm"></span>
                    </div>

                    <div class="mb-8">
                        <label asp-for="Prenom" class="block text-xl font-semibold text-gray-800 mb-4">Prénom</label>
                        <div class="relative">
                            <input type="text" name="Prenom" id="Prenom" class="w-full p-5 pl-14 focus:ring-2 focus:ring-indigo-500 border-2 border-gray-300 rounded-xl transition-all duration-300 placeholder-gray-400 focus:border-indigo-500" asp-for="Prenom" placeholder="Entrez votre prénom" />
                            <i class="fas fa-user absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500"></i>
                        </div>
                        <span asp-validation-for="Prenom" class="text-red-500 text-sm"></span>
                    </div>
                </div>

                <!-- Email & Téléphone -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-10 mb-10">
                    <div class="mb-8">
                        <label asp-for="Email" class="block text-xl font-semibold text-gray-800 mb-4">Email</label>
                        <div class="relative">
                            <input type="email" name="Email" id="Email" class="w-full p-5 pl-14 focus:ring-2 focus:ring-indigo-500 border-2 border-gray-300 rounded-xl transition-all duration-300 placeholder-gray-400 focus:border-indigo-500" asp-for="Email" placeholder="Entrez votre email" />
                            <i class="fas fa-envelope absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500"></i>
                        </div>
                        <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
                    </div>

                    <div class="mb-8">
                        <label asp-for="PhoneNumber" class="block text-xl font-semibold text-gray-800 mb-4">Téléphone</label>
                        <div class="relative">
                            <input type="text" name="PhoneNumber" id="PhoneNumber" class="w-full p-5 pl-14 focus:ring-2 focus:ring-indigo-500 border-2 border-gray-300 rounded-xl transition-all duration-300 placeholder-gray-400 focus:border-indigo-500" asp-for="PhoneNumber" placeholder="Entrez votre numéro de téléphone" />
                            <i class="fas fa-phone-alt absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500"></i>
                        </div>
                        <span asp-validation-for="PhoneNumber" class="text-red-500 text-sm"></span>
                    </div>
                </div>

                <!-- Adresse -->
                <div class="mb-10">
                    <label asp-for="Adresse" class="block text-xl font-semibold text-gray-800 mb-4">Adresse</label>
                    <div class="relative">
                        <input type="text" name="Adresse" id="Adresse" class="w-full p-5 pl-14 focus:ring-2 focus:ring-indigo-500 border-2 border-gray-300 rounded-xl transition-all duration-300 placeholder-gray-400 focus:border-indigo-500" asp-for="Adresse" placeholder="Entrez votre adresse" />
                        <i class="fas fa-map-marker-alt absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500"></i>
                    </div>
                    <span asp-validation-for="Adresse" class="text-red-500 text-sm"></span>
                </div>

                <!-- Mot de Passe & Confirmer -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-10 mb-10">
                    <div class="mb-8">
                        <label asp-for="Password" class="block text-xl font-semibold text-gray-800 mb-4">Mot de passe</label>
                        <div class="relative">
                            <input type="password" name="Password" id="Password" class="w-full p-5 pl-14 focus:ring-2 focus:ring-indigo-500 border-2 border-gray-300 rounded-xl transition-all duration-300 placeholder-gray-400 focus:border-indigo-500" asp-for="Password" placeholder="Entrez votre mot de passe" />
                            <i class="fas fa-lock absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500"></i>
                        </div>
                        <span asp-validation-for="Password" class="text-red-500 text-sm"></span>
                    </div>

                    <div class="mb-8">
                        <label asp-for="ConfirmPassword" class="block text-xl font-semibold text-gray-800 mb-4">Confirmer le mot de passe</label>
                        <div class="relative">
                            <input type="password" name="ConfirmPassword" id="ConfirmPassword" class="w-full p-5 pl-14 focus:ring-2 focus:ring-indigo-500 border-2 border-gray-300 rounded-xl transition-all duration-300 placeholder-gray-400 focus:border-indigo-500" asp-for="ConfirmPassword" placeholder="Confirmez votre mot de passe" />
                            <i class="fas fa-lock absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-500"></i>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm"></span>
                    </div>
                </div>

                <!-- Register Button -->
                <button type="submit" class="w-full px-6 py-3 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 focus:outline-none transition-all duration-300">
                    Créer un compte
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}
